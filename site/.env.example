# Production hosting: supply your actual HTTPS origin.
SITE_ORIGIN=https://your-site.example
COOKIE_SECURE=true
# Optional free hosted PostgreSQL (for example, Neon). Keep the actual URL private.
# DATABASE_URL=postgresql://USER:PASSWORD@YOUR-DATABASE-HOST/DBNAME?sslmode=require
# WEB_CONCURRENCY=1
# Durable storage directory; never commit the database or private data.
# TRENDSCULPT_DATA_DIR=/app/.data
# Optional external import credentials, server only:
# YOUTUBE_API_KEY=
# HF_TOKEN=
# KAGGLE_USERNAME=
# KAGGLE_KEY=
